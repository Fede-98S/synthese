    `roman'.},
  choice teiexport = {false = {},
    true = {\tei@exporttrue
      \AtBeginDocument{\luadirect{ekddrama.openteistream()}}%
      \AtEndDocument{\luadirect{ekddrama.closeteistream()}}},
    tidy = {\tei@exporttrue
